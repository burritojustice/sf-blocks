{
  "_doc": "Map layers built by scripts/build_tiles.py into data/tiles/<id>.pmtiles (or <id>.geojson when small), with <id>.stats.json and the manifest index.json. fields: name → \"type:source\" (see the script's --help). year: what the data describes, shown in the apps; confirm it by hand (a dataset's 'updated' date can be years after its data).",
  "layers": [
    {
      "id": "curbs",
      "label": "Curbs and islands",
      "dataset": "emxt-b6yg",
      "page": "https://data.sf.gov/City-Infrastructure/Curbs-and-Islands/emxt-b6yg",
      "format": "geojson",
      "year": "2016",
      "fields": {
        "kind": "lower:layer",
        "id": "int:objectid"
      },
      "categories": [
        "kind"
      ],
      "tiles": {
        "minzoom": 13,
        "maxzoom": 17
      },
      "ids": [
        "id"
      ]
    },
    {
      "id": "street_trees",
      "label": "Street trees",
      "dataset": "tkzw-k3nq",
      "page": "https://data.sf.gov/City-Infrastructure/San-Francisco-Street-Tree-Inventory/tkzw-k3nq",
      "format": "csv",
      "point": {
        "lon": "longitude",
        "lat": "latitude"
      },
      "year": "current",
      "fields": {
        "treeid": "int:treeid",
        "species": "latin:species",
        "common": "common:species",
        "genus": "genus:species",
        "dbh_in": "int:mapdbh",
        "status": "text:legalstatus",
        "planted": "date:planteddate",
        "site": "text:siteinfo",
        "caretaker": "text:waterresponsibility|planter",
        "cnn": "int:cnn",
        "address": "before_bar:description"
      },
      "categories": [
        "genus",
        "species",
        "status",
        "site",
        "caretaker"
      ],
      "tiles": {
        "minzoom": 15,
        "maxzoom": 15,
        "overview": {
          "minzoom": 10,
          "maxzoom": 14,
          "fields": [
            "genus",
            "dbh_in"
          ]
        }
      },
      "ids": [
        "treeid",
        "cnn"
      ],
      "drop": {
        "site": "^[\\s:]*$"
      }
    },
    {
      "id": "businesses",
      "label": "Businesses",
      "dataset": "g8m3-pdis",
      "page": "https://data.sf.gov/Economy-and-Community/Registered-Business-Locations-San-Francisco/g8m3-pdis",
      "format": "csv",
      "point": {
        "wkt": "location"
      },
      "year": "current",
      "fields": {
        "ttxid": "text:ttxid",
        "dba": "text:dba_name",
        "owner": "text:ownership_name",
        "address": "text:full_business_address",
        "zip": "text:business_zip",
        "mail": "text:mailing_address_1",
        "mail_place": "text:mail_city+mail_state+mail_zipcode",
        "since": "date:location_start_date",
        "lic": "text:lic_code_description",
        "naics": "naics:self_reported_naics_code",
        "sector": "sector:self_reported_naics_code",
        "cat": "bizcategory:lic_code_descriptions_list,self_reported_naics_code",
        "corridor": "text:business_corridor"
      },
      "drop": {
        "dba": "^(N/A|Same As Ownership)$",
        "mail": "^0000 "
      },
      "same_as": {
        "mail": "address",
        "owner": "dba"
      },
      "kinds": {
        "file": "business_kinds.json",
        "by": "owner"
      },
      "group": {
        "by": "address",
        "stack": true,
        "counts": "cat",
        "list": [
          "dba",
          "owner",
          "mail",
          "mail_place",
          "lic",
          "sector",
          "naics",
          "cat",
          "since",
          "kind"
        ],
        "keep": [
          "zip",
          "corridor"
        ]
      },
      "categories": [
        "cat",
        "sector",
        "lic",
        "corridor",
        "kind"
      ],
      "tiles": {
        "minzoom": 15,
        "maxzoom": 15,
        "overview": {
          "minzoom": 10,
          "maxzoom": 14,
          "fields": [
            "n",
            "shown",
            "cat",
            "n_*",
            "shown_*"
          ]
        }
      },
      "where": "location_end_date IS NULL AND dba_end_date IS NULL",
      "note": "Open locations from Registered Business Locations (the same rows as Active Business Locations, kvj8-g7jh), which also has each business's self-reported NAICS code and the mailing city and ZIP.",
      "empty_with": {
        "mail_place": "mail"
      }
    },
    {
      "id": "buildings",
      "label": "Building footprints",
      "dataset": "ynuv-fyni",
      "page": "https://data.sf.gov/Geographic-Locations-and-Boundaries/Building-Footprints/ynuv-fyni",
      "format": "geojson",
      "select": [
        "sf16_bldgid",
        "mblr",
        "hgt_median_m",
        "gnd_min_m",
        "peak_1st_m",
        "shape"
      ],
      "year": "2016 (heights from 2010 LiDAR)",
      "fields": {
        "id": "text:sf16_bldgid",
        "blklot": "text:mblr",
        "height_m": "num1:hgt_median_m",
        "ground_m": "num1:gnd_min_m",
        "peak_m": "num1:peak_1st_m"
      },
      "tiles": {
        "minzoom": 15,
        "maxzoom": 15
      }
    },
    {
      "id": "storm_drains",
      "label": "Storm Drains",
      "dataset": "jtgq-b7c5",
      "page": "https://data.sf.gov/d/jtgq-b7c5",
      "year": "current",
      "fields": {
        "dpw_node_id": "text:dpw_node_id",
        "puc_maximo_asset_id": "text:puc_maximo_asset_id",
        "system_use_code": "text:system_use_code",
        "system_use": "text:system_use",
        "drain_type": "text:drain_type",
        "point_x": "num:point_x",
        "point_y": "num:point_y",
        "analysis_neighborhood": "text:analysis_neighborhood",
        "supervisor_district": "text:supervisor_district"
      },
      "categories": [],
      "tiles": {
        "minzoom": 15,
        "maxzoom": 15
      },
      "format": "csv",
      "point": {
        "wkt": "location"
      }
    },
    {
      "id": "bus_stops",
      "label": "Bus Stops",
      "dataset": "i28k-bkz6",
      "page": "https://data.sf.gov/d/i28k-bkz6",
      "year": "current",
      "fields": {
        "stopname": "text:stopname",
        "trapezestopabbr": "text:trapezestopabbr",
        "rucusstopabbr": "text:rucusstopabbr",
        "stopid": "num:stopid",
        "latitude": "num:latitude",
        "longitude": "num:longitude",
        "accessibilitymask": "num:accessibilitymask",
        "atstreet": "text:atstreet",
        "onstreet": "text:onstreet",
        "position": "text:position",
        "orientation": "text:orientation",
        "serviceplanningstoptype": "text:serviceplanningstoptype",
        "shelter": "num:shelter",
        "insert_timestamp": "text:insert_timestamp",
        "sde_id": "num:sde_id",
        "signupid": "num:signupid",
        "supervisor_district": "text:supervisor_district"
      },
      "categories": [],
      "tiles": {
        "minzoom": 15,
        "maxzoom": 15
      },
      "format": "csv",
      "point": {
        "wkt": "shape"
      }
    }
  ]
}
